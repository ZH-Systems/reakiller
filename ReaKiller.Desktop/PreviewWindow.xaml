<Window x:Class="ReaKiller.Desktop.PreviewWindow"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 Title="ReaKiller | Before and after" Width="1050" Height="660"
 MinWidth="730" MinHeight="480" Background="#F2F6FB"
 WindowStartupLocation="CenterOwner" FontFamily="Segoe UI">
 <Grid Margin="22">
  <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
  <StackPanel Margin="0,0,0,18">
   <TextBlock Text="Before &amp; after" FontSize="25" FontWeight="SemiBold" Foreground="#103968"
    ToolTip="The left image has default conversion settings. The right image uses your current adjustments."/>
   <TextBlock Text="Use this visual comparison before applying changes to an entire batch."
    Foreground="#607B98" Margin="0,5,0,0"/>
  </StackPanel>
  <Grid Grid.Row="1">
   <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="16"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
   <Border Grid.Column="0" Background="White" CornerRadius="12" BorderBrush="#DFE8F4" BorderThickness="1" Padding="12">
    <DockPanel>
     <TextBlock DockPanel.Dock="Top" Text="ORIGINAL APPEARANCE" Foreground="#52779A"
      FontWeight="SemiBold" Margin="4,3,0,12"/>
     <ScrollViewer HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto">
      <Image x:Name="BeforeImage" Stretch="Uniform" ToolTip="Default PNG rendering without adjustments"/>
     </ScrollViewer>
    </DockPanel>
   </Border>
   <Border Grid.Column="2" Background="White" CornerRadius="12" BorderBrush="#DFE8F4" BorderThickness="1" Padding="12">
    <DockPanel>
     <TextBlock DockPanel.Dock="Top" Text="WITH ENHANCEMENTS" Foreground="#52779A"
      FontWeight="SemiBold" Margin="4,3,0,12"/>
     <ScrollViewer HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto">
      <Image x:Name="AfterImage" Stretch="Uniform" ToolTip="PNG output with selected contrast, sharpening, and resizing"/>
     </ScrollViewer>
    </DockPanel>
   </Border>
  </Grid>
  <DockPanel Grid.Row="2" Margin="0,17,0,0">
   <TextBlock x:Name="FileLabel" Foreground="#607B98" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
   <Button DockPanel.Dock="Right" Content="Close preview" Click="Close_Click" HorizontalAlignment="Right"/>
  </DockPanel>
 </Grid>
</Window>