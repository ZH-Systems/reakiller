<Window x:Class="ReaKiller.Desktop.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="ReaKiller | Image Converter" Height="720" Width="1020"
        MinHeight="620" MinWidth="800" Background="{StaticResource Canvas}"
        WindowStartupLocation="CenterScreen" FontFamily="Segoe UI">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="104"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>
        <Border Background="{StaticResource DeepBlue}" Grid.Row="0">
            <Grid Margin="32,16">
                <StackPanel>
                    <TextBlock Text="ReaKiller" FontWeight="Bold" FontSize="30" Foreground="White"/>
                    <TextBlock Text="LOCAL IMAGE CONVERSION  ·  IMG  /  DICOM  /  JPEG  /  TIFF  →  PNG"
                               Foreground="#C4DEFA" FontSize="12" Margin="0,5,0,0"/>
                </StackPanel>
                <Border HorizontalAlignment="Right" VerticalAlignment="Center" Background="#24588B"
                        Padding="12,7" CornerRadius="14">
                    <TextBlock Text="●  Local processing" Foreground="White" FontSize="12"/>
                </Border>
            </Grid>
        </Border>
        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
          <StackPanel Margin="32,25,32,30">
            <TextBlock Text="Convert images" FontSize="22" FontWeight="SemiBold" Foreground="#153657"/>
            <TextBlock Text="Select a folder, choose the destination, and convert safely to PNG."
                       Foreground="#637D98" Margin="0,4,0,20"/>
            <Border Background="White" CornerRadius="12" Padding="24" BorderBrush="#DFEAF5" BorderThickness="1">
              <StackPanel>
                <TextBlock Text="Source folder or file" FontWeight="SemiBold" Foreground="#173B60"/>
                <Grid Margin="0,8,0,17">
                  <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                  <TextBox x:Name="SourcePath" MinWidth="250" />
                  <Button Grid.Column="1" Content="Browse folder" Margin="10,0,0,0" Click="BrowseSource_Click"/>
                </Grid>
                <CheckBox x:Name="InPlace" Content="Replace converted source files in place"
                          Checked="InPlace_Changed" Unchecked="InPlace_Changed" Foreground="#173B60"/>
                <TextBlock Text="In-place mode deletes an original only after successful conversion. Back up files first."
                           Foreground="#A16A26" FontSize="12" Margin="21,5,0,18"/>
                <TextBlock Text="Output folder" FontWeight="SemiBold" Foreground="#173B60"/>
                <Grid Margin="0,8,0,20">
                  <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                  <TextBox x:Name="OutputPath" />
                  <Button x:Name="BrowseOutput" Grid.Column="1" Content="Browse folder" Margin="10,0,0,0" Click="BrowseOutput_Click"/>
                </Grid>
                <WrapPanel>
                  <CheckBox x:Name="Recursive" Content="Include subfolders" IsChecked="True" Margin="0,0,28,0"/>
                  <CheckBox x:Name="Overwrite" Content="Overwrite existing PNGs" Margin="0,0,28,0"/>
                </WrapPanel>
                <Grid Margin="0,19,0,0">
                  <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                  <StackPanel Margin="0,0,14,0">
                    <TextBlock Text="PNG compression" FontWeight="SemiBold" Foreground="#173B60" Margin="0,0,0,7"/>
                    <ComboBox x:Name="Compression" SelectedIndex="1" Padding="8,7">
                      <ComboBoxItem Content="Lossless (balanced)" Tag="lossless"/>
                      <ComboBoxItem Content="Maximum lossless" Tag="max"/>
                    </ComboBox>
                  </StackPanel>
                  <StackPanel Grid.Column="1" Margin="0,0,14,0">
                    <TextBlock Text="Parallel workers" FontWeight="SemiBold" Foreground="#173B60" Margin="0,0,0,7"/>
                    <TextBox x:Name="Threads" Text="4"/>
                  </StackPanel>
                  <StackPanel Grid.Column="2">
                    <TextBlock Text="Max width (optional)" FontWeight="SemiBold" Foreground="#173B60" Margin="0,0,0,7"/>
                    <TextBox x:Name="MaxWidth" ToolTip="Blank preserves native resolution"/>
                  </StackPanel>
                </Grid>
              </StackPanel>
            </Border>
            <Border Background="White" CornerRadius="12" Padding="24" BorderBrush="#DFEAF5" BorderThickness="1" Margin="0,18,0,0">
              <StackPanel>
                <DockPanel>
                  <TextBlock Text="Conversion progress" FontSize="17" FontWeight="SemiBold" Foreground="#173B60"/>
                  <TextBlock x:Name="ProgressText" Text="Ready" DockPanel.Dock="Right" HorizontalAlignment="Right"
                             Foreground="#587D9F"/>
                </DockPanel>
                <ProgressBar x:Name="Progress" Height="12" Minimum="0" Maximum="100" Margin="0,17,0,15"
                             Foreground="{StaticResource AkituBlue}" Background="#DDEAF7"/>
                <TextBox x:Name="Log" IsReadOnly="True" Height="110" FontFamily="Consolas" FontSize="12"
                         TextWrapping="Wrap" VerticalScrollBarVisibility="Auto" Background="#F6F9FD"/>
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,18,0,0">
                  <Button x:Name="CancelButton" Content="Cancel" Background="#7B90A7"
                          Margin="0,0,12,0" IsEnabled="False" Click="Cancel_Click"/>
                  <Button x:Name="StartButton" Content="Start conversion →" MinWidth="165"
                          Click="Start_Click"/>
                </StackPanel>
              </StackPanel>
            </Border>
          </StackPanel>
        </ScrollViewer>
    </Grid>
</Window>