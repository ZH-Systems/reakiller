<Window x:Class="ReaKiller.Desktop.MainWindow"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 xmlns:local="clr-namespace:ReaKiller.Desktop"
 Title="ReaKiller — File utilities" Width="1200" Height="800" MinWidth="920" MinHeight="620"
 WindowStartupLocation="CenterScreen" Background="#F5F6F8" FontFamily="Segoe UI"
 AllowDrop="True" DragOver="Window_DragOver" Drop="Window_Drop">
 <Window.Resources>
  <SolidColorBrush x:Key="Ink" Color="#202832"/>
  <SolidColorBrush x:Key="Muted" Color="#6C7785"/>
  <SolidColorBrush x:Key="Accent" Color="#2763C4"/>
  <Style x:Key="Heading" TargetType="TextBlock">
   <Setter Property="Foreground" Value="{StaticResource Ink}"/>
   <Setter Property="FontSize" Value="15"/>
   <Setter Property="FontWeight" Value="SemiBold"/>
  </Style>
  <Style x:Key="FieldLabel" TargetType="TextBlock">
   <Setter Property="Foreground" Value="#485465"/>
   <Setter Property="FontWeight" Value="SemiBold"/>
   <Setter Property="FontSize" Value="12"/>
   <Setter Property="Margin" Value="0,0,0,6"/>
  </Style>
  <Style TargetType="CheckBox"><Setter Property="Foreground" Value="#354253"/></Style>
  <Style TargetType="ProgressBar">
   <Setter Property="Foreground" Value="#2763C4"/>
   <Setter Property="Background" Value="#E4EAF2"/>
  </Style>
 </Window.Resources>
 <Grid>
  <Grid.RowDefinitions>
   <RowDefinition Height="64"/>
   <RowDefinition Height="*"/>
   <RowDefinition Height="68"/>
  </Grid.RowDefinitions>
  <Border Grid.Row="0" Background="White" BorderBrush="#E0E4EA" BorderThickness="0,0,0,1">
   <Grid Margin="24,0">
    <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
    <Border Background="#2763C4" Width="30" Height="30" CornerRadius="6" VerticalAlignment="Center">
     <TextBlock Text="R" Foreground="White" FontSize="17" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center"/>
    </Border>
    <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center" Margin="12,0,0,0">
     <TextBlock Text="ReaKiller" FontSize="19" FontWeight="SemiBold" Foreground="#202832"/>
     <Border Width="1" Background="#D7DCE3" Margin="15,4"/>
     <TextBlock Text="File utilities" VerticalAlignment="Center" FontSize="13" Foreground="#6C7785"/>
    </StackPanel>
    <TextBlock Grid.Column="2" Text="Local image and PDF processing" VerticalAlignment="Center" Foreground="#6C7785" FontSize="12"
     ToolTip="Process image files locally; no images are uploaded."/>
   </Grid>
  </Border>
  <TabControl x:Name="FeatureTabs" Grid.Row="1" Background="#F5F6F8" BorderThickness="0" Padding="0">
   <TabItem Header="Image conversion">
  <Grid>
   <Grid.ColumnDefinitions><ColumnDefinition Width="410"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
   <Border Grid.Column="0" Background="White" BorderBrush="#E0E4EA" BorderThickness="0,0,1,0">
    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
     <StackPanel Margin="24,22,24,30">
      <DockPanel Margin="0,0,0,14">
       <TextBlock Text="Input &amp; output" Style="{StaticResource Heading}" ToolTip="Select the images to convert and configure output names and destination."/>
       <TextBlock x:Name="FileCountText" Text="No source selected" DockPanel.Dock="Right" Foreground="{StaticResource Muted}" FontSize="11" VerticalAlignment="Center"/>
      </DockPanel>
      <CheckBox x:Name="SingleFileMode" Content="Choose individual files" Margin="0,0,0,12"
       Checked="SingleFileMode_Changed" Unchecked="SingleFileMode_Changed"
       ToolTip="Switch between folder processing and one or more selected image files."/>
      <TextBlock Text="Source" Style="{StaticResource FieldLabel}" ToolTip="Pick a folder or individual images."/>
      <Grid>
       <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
       <TextBox x:Name="SourcePath" IsReadOnly="False" TextChanged="SourcePath_Changed" ToolTip="Folder path, or the current individual-file selection."/>
       <Button Grid.Column="1" Content="Browse" Style="{StaticResource SecondaryButton}" Click="BrowseSource_Click" Margin="8,0,0,0" MinWidth="74" ToolTip="Select source folders or individual image files."/>
      </Grid>
      <TextBlock x:Name="SelectedFilesHint" Visibility="Collapsed" Text="Only the files you select will be converted." Margin="0,7,0,0" Foreground="{StaticResource Muted}" FontSize="11"/>
      <Grid Margin="0,12,0,0">
       <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
       <CheckBox x:Name="Recursive" Content="Include subfolders" IsChecked="True" VerticalAlignment="Center" Checked="ScanSetting_Changed" Unchecked="ScanSetting_Changed"
        ToolTip="Include image files from nested folders."/>
       <Button x:Name="ScanButton" Grid.Column="1" Content="Scan files" Style="{StaticResource SecondaryButton}" Click="Scan_Click" ToolTip="Count supported images before conversion."/>
      </Grid>
      <TextBlock Text="Destination" Style="{StaticResource FieldLabel}" Margin="0,19,0,6" ToolTip="Choose a separate output directory."/>
      <Grid>
       <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
       <TextBox x:Name="OutputPath" ToolTip="Output folder for converted PNGs."/>
       <Button x:Name="BrowseOutput" Grid.Column="1" Content="Browse" Style="{StaticResource SecondaryButton}" Click="BrowseOutput_Click" Margin="8,0,0,0" MinWidth="74"/>
      </Grid>
      <CheckBox x:Name="InPlace" Content="Replace original files after successful conversion"
       Margin="0,11,0,0" Checked="InPlace_Changed" Unchecked="InPlace_Changed"
       ToolTip="Destructive mode. Originals are deleted only after their PNG outputs have been written and verified."/>
      <TextBlock Text="Use a backup when replacing originals." Margin="22,4,0,0" FontSize="11" Foreground="#9A5D2C"/>
      <CheckBox x:Name="OptimizeInPlace" Content="Optimize PNG in place (same dimensions)" Margin="0,14,0,0" Checked="OptimizeInPlace_Changed" Unchecked="OptimizeInPlace_Changed" ToolTip="Lossless PNG recompression only. Never changes resolution; replaces only if smaller. JPEG and medical formats are skipped."/>
      <TextBlock Text="Filename pattern" Style="{StaticResource FieldLabel}" Margin="0,18,0,6" ToolTip="Control output names using placeholders. The PNG extension is added automatically."/>
      <TextBox x:Name="NamePattern" Text="{}{name}_{ext}" TextChanged="NamePattern_Changed"
       ToolTip="Supported placeholders: {name}, {ext}, {index}, {date}."/>
      <TextBlock Text="Tokens: {name} · {ext} · {index} · {date}" FontSize="11" Foreground="{StaticResource Muted}" Margin="0,7,0,0"
       ToolTip="Name is original stem; ext is original extension; index is five-digit sequence; date is modified date."/>
      <TextBlock x:Name="NamePreview" Text="Example: I11624_img.png" FontSize="11" Foreground="#2763C4" Margin="0,5,0,0"/>
      <Border Height="1" Background="#E4E8EE" Margin="0,23,0,20"/>
      <TextBlock Text="Output format" Style="{StaticResource FieldLabel}" Margin="0,0,0,7"/>
      <ComboBox x:Name="OutputFormat" SelectedIndex="0" SelectionChanged="OutputFormat_Changed" Margin="0,0,0,17">
       <ComboBoxItem Content="PNG — lossless" Tag="png"/>
       <ComboBoxItem Content="JPEG — smaller, lossy" Tag="jpg"/>
      </ComboBox>
      <TextBlock Text="Output settings" Style="{StaticResource Heading}" ToolTip="Configure compression, processing threads, and dimensions." Margin="0,0,0,15"/>
      <Grid>
       <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="12"/><ColumnDefinition Width="78"/><ColumnDefinition Width="12"/><ColumnDefinition Width="88"/></Grid.ColumnDefinitions>
       <StackPanel Grid.Column="0">
        <TextBlock Text="Compression" Style="{StaticResource FieldLabel}" ToolTip="Lossless PNG compression preset."/>
        <ComboBox x:Name="Compression" SelectedIndex="1" Padding="6">
         <ComboBoxItem Content="Balanced" Tag="lossless"/>
         <ComboBoxItem Content="Maximum" Tag="max"/>
        </ComboBox>
       </StackPanel>
       <StackPanel Grid.Column="2">
        <TextBlock Text="Workers" Style="{StaticResource FieldLabel}" ToolTip="Concurrent conversion threads."/>
        <TextBox x:Name="Threads" Text="4"/>
       </StackPanel>
       <StackPanel Grid.Column="4">
        <TextBlock Text="Max width" Style="{StaticResource FieldLabel}" ToolTip="Optional resize limit in pixels. Blank preserves dimensions."/>
        <TextBox x:Name="MaxWidthInput"/>
       </StackPanel>
      </Grid>
      <DockPanel Margin="0,18,0,5">
       <TextBlock Text="Compression effort" Style="{StaticResource FieldLabel}" ToolTip="Encoding effort, not a target percentage file-size reduction."/>
       <TextBlock x:Name="EffortValue" DockPanel.Dock="Right" Text="100%" FontSize="12" Foreground="{StaticResource Muted}"/>
      </DockPanel>
      <Slider x:Name="EffortSlider" Minimum="0" Maximum="100" Value="100" TickFrequency="5" IsSnapToTickEnabled="True"
       ValueChanged="EffortSlider_Changed" ToolTip="Higher values can reduce PNG size but require more CPU time. Image quality is unchanged."/>
      <CheckBox x:Name="Overwrite" Content="Overwrite existing PNGs" Margin="0,15,0,0"
       ToolTip="Replace output files when they already exist."/>
      <Border Height="1" Background="#E4E8EE" Margin="0,23,0,20"/>
      <TextBlock Text="Image adjustments" Style="{StaticResource Heading}" ToolTip="Optional processing. These settings modify the image pixels."/>
      <TextBlock Text="Off by default. Preview changes before running a batch." Foreground="{StaticResource Muted}" FontSize="11" Margin="0,5,0,13"
       TextWrapping="Wrap"/>
      <CheckBox x:Name="AutoContrast" Content="Auto contrast" Margin="0,0,0,14"
       ToolTip="Automatically stretch the image tonal range."/>
      <DockPanel Margin="0,0,0,5">
       <TextBlock Text="Contrast" Style="{StaticResource FieldLabel}" ToolTip="Manual contrast adjustment; zero means off."/>
       <TextBlock x:Name="ContrastValue" Text="0" DockPanel.Dock="Right" Foreground="{StaticResource Muted}"/>
      </DockPanel>
      <Slider x:Name="ContrastSlider" Minimum="-50" Maximum="50" Value="0" TickFrequency="5" IsSnapToTickEnabled="True"
       ValueChanged="ContrastSlider_Changed" ToolTip="Increase or decrease contrast. Can amplify radiograph artifacts."/>
      <DockPanel Margin="0,15,0,5">
       <TextBlock Text="Sharpening" Style="{StaticResource FieldLabel}" ToolTip="Unsharp mask amount. Higher values emphasize edges and noise."/>
       <TextBlock x:Name="SharpenValue" Text="0.0" DockPanel.Dock="Right" Foreground="{StaticResource Muted}"/>
      </DockPanel>
      <Slider x:Name="SharpenSlider" Minimum="0" Maximum="2" Value="0" TickFrequency="0.1" IsSnapToTickEnabled="True"
       ValueChanged="SharpenSlider_Changed"/>
      <Button Content="Preview adjustments" Style="{StaticResource SecondaryButton}" Click="Preview_Click" Margin="0,17,0,0" HorizontalAlignment="Left"
       ToolTip="Compare an unmodified PNG rendering with your current adjustments."/>
      <WrapPanel Margin="0,15,0,0">
       <Button Content="Save preset" Style="{StaticResource SecondaryButton}" Click="SavePreset_Click" ToolTip="Save these settings as a JSON file."/>
       <Button Content="Load preset" Style="{StaticResource SecondaryButton}" Click="LoadPreset_Click" Margin="8,0,0,0" ToolTip="Load saved JSON settings."/>
      </WrapPanel>
     </StackPanel>
    </ScrollViewer>
   </Border>
   <Grid Grid.Column="1" Margin="28,25,28,24">
    <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
    <DockPanel>
     <StackPanel>
      <TextBlock Text="Conversion activity" FontSize="23" FontWeight="SemiBold" Foreground="#202832" ToolTip="Conversion status and results appear here."/>
      <TextBlock Text="File-by-file results from the current job" FontSize="12" Foreground="#6C7785" Margin="0,5,0,0"/>
     </StackPanel>
     <Button x:Name="OpenReportButton" Content="Open CSV report" Style="{StaticResource SecondaryButton}" DockPanel.Dock="Right" HorizontalAlignment="Right"
      Click="OpenReport_Click" IsEnabled="False" VerticalAlignment="Center" ToolTip="Open the complete CSV conversion report."/>
    </DockPanel>
    <Border Grid.Row="1" Background="White" BorderBrush="#DFE4EC" BorderThickness="1" CornerRadius="7" Margin="0,22,0,18" Padding="18,14">
     <StackPanel>
      <DockPanel Margin="0,0,0,10">
       <TextBlock Text="Progress" Foreground="#485465" FontWeight="SemiBold" FontSize="12"/>
       <TextBlock x:Name="ProgressText" Text="Ready to convert" DockPanel.Dock="Right" Foreground="#6C7785" FontSize="12"/>
      </DockPanel>
      <ProgressBar x:Name="Progress" Height="12" Minimum="0" Maximum="100"
       ToolTip="Visual progress updates for each completed image."/>
      <TextBlock x:Name="SummaryText" Text="Select images and start a conversion." Foreground="#6C7785" FontSize="12" Margin="0,10,0,0"/>
     </StackPanel>
    </Border>
    </TabItem>
  <TabItem Header="PDF compression">
   <local:PdfCompressionTab />
  </TabItem>
  </TabControl>
  <Border Grid.Row="2" Background="White" BorderBrush="#DFE4EC" BorderThickness="1" CornerRadius="7" ClipToBounds="True">
     <Grid>
      <Grid.RowDefinitions><RowDefinition Height="42"/><RowDefinition Height="*"/></Grid.RowDefinitions>
      <Border BorderBrush="#E8EBF0" BorderThickness="0,0,0,1" Background="#FAFBFC">
       <Grid Margin="16,0">
        <TextBlock Text="Files" Foreground="#3A4655" FontWeight="SemiBold" VerticalAlignment="Center"
         ToolTip="Green succeeded, red failed, gray skipped, and orange stopped."/>
       </Grid>
      </Border>
      <ListView Grid.Row="1" x:Name="ResultsList" BorderThickness="0" Background="White"
       ScrollViewer.VerticalScrollBarVisibility="Auto" VirtualizingPanel.IsVirtualizing="True">
       <ListView.View>
        <GridView>
         <GridViewColumn Header="File" Width="280" DisplayMemberBinding="{Binding FileName}"/>
         <GridViewColumn Header="Status" Width="108">
          <GridViewColumn.CellTemplate>
           <DataTemplate><TextBlock Text="{Binding Status}" Foreground="{Binding StatusColor}" FontWeight="SemiBold" ToolTip="{Binding Detail}"/></DataTemplate>
          </GridViewColumn.CellTemplate>
         </GridViewColumn>
         <GridViewColumn Header="Details" Width="250" DisplayMemberBinding="{Binding Detail}"/>
        </GridView>
       </ListView.View>
      </ListView>
     </Grid>
    </Border>
    <Expander Grid.Row="3" Header="Technical log" Margin="0,12,0,0" ToolTip="Show raw output for troubleshooting.">
     <TextBox x:Name="Log" IsReadOnly="True" Height="115" FontFamily="Consolas" FontSize="12"
      TextWrapping="NoWrap" HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto" Background="White"/>
    </Expander>
   </Grid>
  </Grid>
  <Border Grid.Row="2" Background="White" BorderBrush="#E0E4EA" BorderThickness="0,1,0,0">
   <Border.Style><Style TargetType="Border"><Style.Triggers><DataTrigger Binding="{Binding SelectedIndex, ElementName=FeatureTabs}" Value="1"><Setter Property="Visibility" Value="Collapsed"/></DataTrigger></Style.Triggers></Style></Border.Style>
   <Grid Margin="24,0">
    <TextBlock Text="Files are processed locally. Originals are kept unless replacement is enabled."
     VerticalAlignment="Center" Foreground="#6C7785" FontSize="12"/>
    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
     <Button x:Name="CancelButton" Content="Stop conversion" Style="{StaticResource DangerButton}" MinWidth="130" IsEnabled="False"
      Click="Cancel_Click" ToolTip="Request a safe stop. Completed output files remain." Margin="0,0,10,0"/>
     <Button x:Name="StartButton" Content="Start conversion" MinWidth="148" Click="Start_Click"/>
    </StackPanel>
   </Grid>
  </Border>
 </Grid>
</Window>