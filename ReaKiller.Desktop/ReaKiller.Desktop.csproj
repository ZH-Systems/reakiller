<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <ApplicationIcon>../assets/ReaKiller.ico</ApplicationIcon>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <UseWindowsForms>true</UseWindowsForms>
    <Nullable>enable</Nullable>
    <Company>ZH-Systems</Company>
    <Authors>ZH-Systems</Authors>
    <Product>ReaKiller</Product>
    <Copyright>Copyright (c) ZH-Systems</Copyright>
    <Version>1.0.0</Version>
    <ImplicitUsings>enable</ImplicitUsings>
    <AssemblyName>ReaKiller.Desktop</AssemblyName>
  </PropertyGroup>
  <ItemGroup>
    <Resource Include="../assets/ReaKiller.ico" Link="ReaKiller.ico" />
  </ItemGroup>
  <Target Name="GenerateReaKillerIcon" BeforeTargets="PrepareForBuild" Condition="'$(OS)' == 'Windows_NT'">
    <Exec Command="powershell -NoProfile -ExecutionPolicy Bypass -File &quot;$(MSBuildProjectDirectory)/../scripts/Generate-Icon.ps1&quot;" />
  </Target>
</Project>