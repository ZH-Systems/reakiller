<UserControl x:Class="ReaKiller.Desktop.PdfCompressionTab"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 Background="#F5F6F8">
 <Grid>
  <Grid.ColumnDefinitions><ColumnDefinition Width="410"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
  <Border Background="White" BorderBrush="#E0E4EA" BorderThickness="0,0,1,0">
   <ScrollViewer VerticalScrollBarVisibility="Auto">
    <StackPanel Margin="24,24,24,24">
     <TextBlock Text="PDF compression" FontSize="16" FontWeight="SemiBold" Foreground="#202832"/>
     <TextBlock Text="Optimize PDFs on this computer. Your files are never uploaded." Margin="0,7,0,20" Foreground="#6C7785" TextWrapping="Wrap"/>
     <TextBlock Text="Source PDF files" FontWeight="SemiBold" Foreground="#485465" Margin="0,0,0,7"/>
     <Grid>
      <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
      <TextBox x:Name="SelectionSummary" IsReadOnly="True" Text="No files selected"/>
      <Button Grid.Column="1" Content="Choose files" Style="{StaticResource SecondaryButton}" Margin="8,0,0,0" Click="ChooseFiles_Click"/>
     </Grid>
     <TextBlock x:Name="SelectedCount" Text="Select one or more PDFs." Foreground="#6C7785" Margin="0,8,0,20" FontSize="12"/>
     <TextBlock Text="Output folder" FontWeight="SemiBold" Foreground="#485465" Margin="0,0,0,7"/>
     <Grid>
      <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
      <TextBox x:Name="DestinationPath" ToolTip="A different destination folder. Original PDF files are never overwritten."/>
      <Button Grid.Column="1" Content="Browse" Style="{StaticResource SecondaryButton}" Margin="8,0,0,0" Click="ChooseDestination_Click"/>
     </Grid>
     <TextBlock Text="Compression level" FontWeight="SemiBold" Foreground="#485465" Margin="0,22,0,7"/>
     <ComboBox x:Name="Preset" SelectedIndex="1" Padding="6">
      <ComboBoxItem Content="Conservative — lossless" Tag="printer"/>
      <ComboBoxItem Content="Balanced — lossless" Tag="ebook"/>
      <ComboBoxItem Content="Maximum — lossless" Tag="screen"/>
     </ComboBox>
     <TextBlock Text="Native optimization currently compresses PDF streams without downsampling images. Reductions depend on the input." Foreground="#6C7785" FontSize="12" TextWrapping="Wrap" Margin="0,9,0,14"/>
     <CheckBox x:Name="SkipLarger" Content="Keep smaller original when compression increases file size" IsChecked="True" Margin="0,4,0,16" ToolTip="If the new PDF is not smaller, do not publish a larger copy."/>
     <Border Height="1" Background="#E4E8EE" Margin="0,4,0,18"/>
     <TextBlock Text="Built-in PDF optimizer" FontWeight="SemiBold" Foreground="#485465"/>
     <TextBlock Text="PDFsharp 6.2.4 · MIT licence · No Ghostscript or separate installation required." Foreground="#6C7785" TextWrapping="Wrap" Margin="0,8,0,12" FontSize="12"/>
     <TextBlock Text="Files are written as *_compressed.pdf. Existing outputs are not overwritten." TextWrapping="Wrap" FontSize="11" Foreground="#6C7785" Margin="0,24,0,0"/>
    </StackPanel>
   </ScrollViewer>
  </Border>
  <Grid Grid.Column="1" Margin="28,25,28,24">
   <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
   <TextBlock Text="PDF results" FontSize="23" FontWeight="SemiBold" Foreground="#202832"/>
   <Border Grid.Row="1" Background="White" CornerRadius="7" BorderBrush="#DFE4EC" BorderThickness="1" Padding="18,14" Margin="0,22,0,18">
    <StackPanel>
     <DockPanel Margin="0,0,0,10">
      <TextBlock Text="Progress" Foreground="#485465" FontWeight="SemiBold"/>
      <TextBlock x:Name="ProgressText" Text="Ready" DockPanel.Dock="Right" Foreground="#6C7785"/>
     </DockPanel>
     <ProgressBar x:Name="Progress" Minimum="0" Maximum="100" Height="12"/>
     <TextBlock x:Name="SummaryText" Text="Select PDFs to compress." Margin="0,10,0,0" Foreground="#6C7785" TextWrapping="Wrap"/>
    </StackPanel>
   </Border>
   <ListView x:Name="Results" Grid.Row="2" Background="White" BorderBrush="#DFE4EC" BorderThickness="1" ScrollViewer.VerticalScrollBarVisibility="Auto">
    <ListView.View>
     <GridView>
      <GridViewColumn Header="File" Width="260" DisplayMemberBinding="{Binding Name}"/>
      <GridViewColumn Header="Original" Width="95" DisplayMemberBinding="{Binding Before}"/>
      <GridViewColumn Header="Output" Width="95" DisplayMemberBinding="{Binding After}"/>
      <GridViewColumn Header="Result" Width="145" DisplayMemberBinding="{Binding Status}"/>
     </GridView>
    </ListView.View>
   </ListView>
   <StackPanel Grid.Row="3" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,18,0,0">
    <Button x:Name="StopButton" Content="Stop" Style="{StaticResource DangerButton}" IsEnabled="False" MinWidth="110" Margin="0,0,10,0" Click="Stop_Click"/>
    <Button x:Name="StartButton" Content="Compress PDFs" MinWidth="160" Click="Start_Click"/>
   </StackPanel>
  </Grid>
 </Grid>
</UserControl>