<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <ApplicationIcon>../assets/ReaKiller.ico</ApplicationIcon>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <Company>ZH-Systems</Company>
    <Authors>ZH-Systems</Authors>
    <Product>ReaKiller</Product>
    <Copyright>Copyright (c) ZH-Systems</Copyright>
    <Version>1.0.0</Version>
    <PublishAot>false</PublishAot>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Magick.NET-Q16-AnyCPU" Version="14.17.2" />
    <PackageReference Include="fo-dicom" Version="5.2.6" />
  </ItemGroup>
  <Target Name="GenerateReaKillerIcon" BeforeTargets="PrepareForBuild" Condition="'$(OS)' == 'Windows_NT'">
    <Exec Command="powershell -NoProfile -ExecutionPolicy Bypass -File &quot;$(MSBuildProjectDirectory)/../scripts/Generate-Icon.ps1&quot;" />
  </Target>
</Project>
